# Copy this file to `.env.local` and fill in the values from your Supabase
# project's API settings (Project Settings → API).
#
# Both values are PUBLIC and safe to ship to the browser — they are identifiers,
# not secrets. The real protection is Row-Level Security, configured in the
# database. Never put the service_role / secret key in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
