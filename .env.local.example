# Copy this file to `.env.local` and fill in the values from your Supabase
# project's API settings (Project Settings → API).
#
# Both values are PUBLIC and safe to ship to the browser — they are identifiers,
# not secrets. The real protection is Row-Level Security, configured in the
# database. Never put the service_role / secret key in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Checkout (Phase 3c). Optional: without all three, the pricing page says
# "Checkout unavailable" and the rest of the app works as before.
#
# Also PUBLIC: a client-side token is meant for the browser, and the price id
# only labels a price — what is sold is decided by the create-checkout Edge
# Function from its own PADDLE_PRICE_ID (supabase/functions/.env.example). The
# secret API key and the webhook secret NEVER go in a NEXT_PUBLIC_* variable.
#
#   NEXT_PUBLIC_PADDLE_ENV           "sandbox" or "production" — must match the token
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN  Paddle → Developer tools → Authentication →
#                                    Client-side tokens (test_… / live_…)
#   NEXT_PUBLIC_PADDLE_PRICE_ID      the Pro product's one-time price (pri_…), the
#                                    same id as the functions' PADDLE_PRICE_ID
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
# NEXT_PUBLIC_PADDLE_PRICE_ID=pri_...

# ---------------------------------------------------------------------------
# Deploy-time only (NOT needed for local dev). Set these in Vercel → Settings →
# Environment Variables, Production scope. They let the build apply Supabase
# migrations and deploy the Edge Functions (see scripts/vercel-migrate.mjs), and
# a production build fails without any one of them. All three are SECRET.
#
#   SUPABASE_DB_URL        the "Session pooler" connection string, with the DB password
#   SUPABASE_ACCESS_TOKEN  Supabase → Account → Access Tokens (for functions deploy)
#   SUPABASE_PROJECT_REF   the project's reference id (its supabase.co subdomain)
# SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=YOUR-REF
# ---------------------------------------------------------------------------
