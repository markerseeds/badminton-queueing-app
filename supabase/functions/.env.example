# Secrets the Edge Functions read (Phase 3c). Names only — never commit values.
#
# Production: set each ONCE with the Supabase CLI, by hand, e.g.
#   supabase secrets set --project-ref <ref> PADDLE_ENV=sandbox PADDLE_API_KEY=pdl_sdbx_apikey_…
# The Vercel build deploys the functions but never pushes secrets.
#
# Local: copy this file to supabase/functions/.env (gitignored), which
# `supabase start` and `supabase functions serve` load. For the HTTP test suite,
# serve with the fixture instead:
#   npx supabase functions serve --env-file tests/fixtures/functions.env
#
# SUPABASE_URL and the service-role key are injected by the platform; don't set
# them.

# "sandbox" or "production" — no default, on purpose. Must match the key below:
# sandbox keys contain _sdbx_, live keys _live_.
PADDLE_ENV=sandbox

# Paddle → Developer tools → Authentication → API keys. Server-side only.
PADDLE_API_KEY=

# Paddle → Developer tools → Notifications → your destination → secret key.
PADDLE_WEBHOOK_SECRET=

# The one-time price of the "Pro" product (pri_…). Must equal the app's
# NEXT_PUBLIC_PADDLE_PRICE_ID.
PADDLE_PRICE_ID=

# Sentry project DSN. Optional: without it, reports only go to the function log.
SENTRY_DSN=
