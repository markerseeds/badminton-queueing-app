# Values the Edge Functions are served with for the HTTP suite (tests/functions/)
# — locally and in CI:
#   npx supabase functions serve --env-file tests/fixtures/functions.env
# and the same file is loaded into the test process so the suite signs requests
# with the secret the function was given.
#
# NONE of these is a credential. The key cannot reach Paddle (the suite only
# exercises paths that refuse before calling it), the webhook secret signs
# nothing but local test requests, and the price id is the fixtures' own.
# Real values live in Supabase's secret store, set by hand — see
# supabase/functions/.env.example.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_LOCAL-TEST-ONLY
PADDLE_WEBHOOK_SECRET=pdl_ntfset_LOCAL-TEST-ONLY-not-a-real-secret
PADDLE_PRICE_ID=pri_01jh8sx0pro0un1ock0one0time
